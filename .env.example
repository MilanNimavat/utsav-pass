# -----------------------------------------------------------------------------
# Sharad Utsav 2026 Ticketing System — Environment Configuration
# -----------------------------------------------------------------------------

# [LOCAL DEVELOPMENT]
# Zero-config mode: No .env is required!
# If DATABASE_URL is omitted, the app automatically falls back to Node.js's built-in
# SQLite engine (utsav.db) and automatically seeds catalog inventory on startup.
#
# Optional SQLite override:
# SQLITE_DB_PATH="utsav.db"

# [PRODUCTION DEPLOYMENT (Vercel / Neon / Supabase)]
# Required for production PostgreSQL.
# Neon Serverless PostgreSQL connection string (with SSL mode enabled):
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# [OPTIONAL STRIPE INTEGRATION]
# If integrating live Stripe payment processing:
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# STRIPE_SECRET_KEY="sk_test_..."
